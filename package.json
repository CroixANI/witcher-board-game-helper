{
  "name": "witcher-board-game-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Фанатский помощник для настольной игры «Ведьмак: Старый мир»",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run && npm run validate:content",
    "validate:content": "tsx scripts/validate-content.ts",
    "prebuild": "npm run validate:content",
    "optimize:svg": "svgo --config svgo.config.mjs -r -f src/assets/svg -q"
  },
  "dependencies": {
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/preact": "^6.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "astro": "^7.4.7",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "preact-render-to-string": "^6.8.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
