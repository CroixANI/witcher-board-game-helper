---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Служебная страница (`/dev/*`): не индексировать. */
  noindex?: boolean;
}

const {
  title,
  description = 'Фанатский помощник для настольной игры «Ведьмак: Старый мир».',
  noindex = false,
} = Astro.props;

const siteName = 'Ведьмак: помощник';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;

// `sections` — разделы, при которых таб подсвечен: карточки правил относятся к «Справке».
const tabs = [
  { path: 'setup', label: 'Подготовка', sections: ['setup'] },
  { path: 'turn', label: 'Ход', sections: ['turn'] },
  { path: 'reference', label: 'Справка', sections: ['reference', 'rules'] },
  { path: 'faq', label: 'FAQ', sections: ['faq'] },
].map(({ path, label, sections }) => ({
  label,
  href: url(path),
  current: sections.some((section) => Astro.url.pathname.startsWith(url(section))),
}));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#14201a" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      К содержимому
    </a>
    <header class="site-header">
      <a class="site-title" href={url()}>
        {siteName}
      </a>
      <nav class="tabbar" aria-label="Основные разделы">
        <ul>
          {tabs.map((tab) => (
            <li>
              <a href={tab.href} aria-current={tab.current ? 'page' : undefined}>
                {tab.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class="content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Фанатский некоммерческий проект. «Ведьмак: Старый мир» © CD PROJEKT RED, Go On Board;
        русское издание — GaGa Games. Тексты — пересказ правил, иллюстрации — собственные схемы.
        Номера страниц — по книге правил из коробки.
      </p>
      <p>
        <a href={url('about')}>О проекте</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: -100px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface-raised);
    color: var(--color-text);
    border-radius: var(--radius);
    z-index: 20;
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  .site-header {
    display: flex;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    padding-top: max(var(--space-3), env(safe-area-inset-top));
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .tabbar ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabbar li {
    flex: 1 1 0;
    min-width: 0;
  }

  .tabbar a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    padding: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    border-radius: var(--radius);
  }

  .tabbar a[aria-current='page'] {
    color: var(--color-on-accent);
    background: var(--color-accent);
  }

  .content {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }

  .site-footer {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    padding-bottom: calc(var(--tabbar-height) + var(--space-5) + env(safe-area-inset-bottom));
    color: var(--color-text-muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--color-border);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  /* Mobile: tab bar закреплён снизу (SPEC 4.2). */
  @media (max-width: 767.98px) {
    .tabbar {
      position: fixed;
      inset: auto 0 0;
      z-index: 10;
      padding: var(--space-1) var(--space-2);
      padding-bottom: max(var(--space-1), env(safe-area-inset-bottom));
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .tabbar ul {
      gap: var(--space-1);
    }
  }

  /* ≥ 768 px: tab bar становится верхней навигацией. */
  @media (min-width: 768px) {
    .site-header {
      justify-content: space-between;
      gap: var(--space-5);
    }

    .tabbar ul {
      gap: var(--space-2);
    }

    .tabbar li {
      flex: none;
    }

    .tabbar a {
      padding: var(--space-2) var(--space-4);
    }

    .site-footer {
      padding-bottom: var(--space-5);
    }
  }
</style>
