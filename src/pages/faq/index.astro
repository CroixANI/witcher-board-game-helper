---
// Список FAQ (SPEC 4.1, 10): вопросы по фазам, у каждого якорь `#slug`; работает без JS.
// Поиск и фильтры — остров `FaqSearch` (R5.2): он скрывает лишнее в готовом списке
// по `data-faq-*` и показывает результаты Pagefind.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqEntry from '../../components/FaqEntry.astro';
import ZonePeek from '../../components/ZonePeek.astro';
import { FaqSearch } from '../../islands/FaqSearch';
import { FAQ_PHASES, groupFaq } from '../../lib/faq';
import { faqTags } from '../../lib/faq-search';

const entries = await getCollection('faq');
const groups = groupFaq(entries);
const items = entries.map((e) => ({ slug: e.id, phase: e.data.phase, tags: e.data.tags }));
---

<BaseLayout
  title="FAQ"
  description="Частые вопросы по правилам «Ведьмак: Старый мир» с номерами страниц книги правил."
>
  <h1>FAQ</h1>
  <p>
    Вопросы, которые возникают за столом. Ответы — своими словами, со ссылкой на страницу книги
    правил или официальный FAQ.
  </p>

  <FaqSearch client:load items={items} phases={FAQ_PHASES} tags={faqTags(items)} />

  <div data-faq-list>
    <nav class="toc" aria-label="Фазы">
      <ul>
        {groups.map((g) => (
          <li data-faq-toc={g.id}>
            <a href={`#phase-${g.id}`}>
              {g.label} ({g.entries.length})
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {groups.map((g) => (
      <section id={`phase-${g.id}`} aria-labelledby={`phase-${g.id}-title`} data-faq-group={g.id}>
        <h2 id={`phase-${g.id}-title`}>{g.label}</h2>
        <ul class="list">
          {g.entries.map((entry) => (
            <li data-faq-item={entry.id}>
              <FaqEntry entry={entry} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <ZonePeek />
</BaseLayout>

<style>
  section {
    margin-top: var(--space-6);
    scroll-margin-top: var(--space-4);
  }

  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  .list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
