---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WizardIsland } from '../../islands/WizardIsland';
import { loadWizardData } from '../../lib/load-wizard-data';

const data = await loadWizardData('setup');
---

<BaseLayout title="Подготовка">
  <h1>Подготовка</h1>
  <p>Пошаговая раскладка поля, карт и жетонов для 2–5 игроков.</p>
  <WizardIsland client:load data={data} />
</BaseLayout>
