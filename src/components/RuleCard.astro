---
// Свёрнутая карточка правила (SPEC 4.4): заголовок, «стр. N», краткое содержание; раскрывается без JS.
import { render, type CollectionEntry } from 'astro:content';
import { formatPages } from '../lib/reference';
import { url } from '../lib/url';
import '../styles/rule-card.css';

interface Props {
  entry: CollectionEntry<'rules'>;
  open?: boolean;
}

const { entry, open = false } = Astro.props;
const { title, page, summary, important } = entry.data;
const { Content } = await render(entry);
---

<details
  class:list={['rule-card', { 'rule-card--important': important }]}
  id={entry.id}
  open={open}
>
  <summary>
    <span class="rule-card__title">{title}</span>
    <span class="rule-card__pages">{formatPages(page)}</span>
  </summary>
  <div class="rule-card__body">
    {important && <p class="rule-card__badge">Важно</p>}
    <p class="rule-card__summary">{summary}</p>
    <Content />
    <p class="rule-card__permalink">
      <a href={url(`rules/${entry.id}`)}>Отдельная страница правила</a>
    </p>
  </div>
</details>
